<mxfile host="drawio"><diagram name="类图2 命令与历史" id="类图2 命令与历史"><mxGraphModel grid="0" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fac" value="&lt;p style=&quot;margin:0;margin-top:5px;text-align:center;line-height:1.25;&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;«utility»&lt;/span&gt;&lt;br&gt;&lt;b&gt;CommandFactory（ops.ts）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ addNode(node, edges): Command&lt;br&gt;+ addEdge(edge): Command&lt;br&gt;+ deleteElements(nodeIds, edgeIds): Command&lt;br&gt;+ setNodePositions(positions, label): Command&lt;br&gt;+ updateNodeText(id, text): Command&lt;br&gt;+ patchNode(id, patch, label): Command&lt;br&gt;+ alignNodes(doc, ids, mode): Command&lt;br&gt;+ …（共 18 个命令工厂）&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=WenQuanYi Zen Hei;fillColor=#F1F1EC;strokeColor=#45453F;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="330" height="216" as="geometry"/></mxCell><mxCell id="cmd" value="&lt;p style=&quot;margin:0;margin-top:5px;text-align:center;line-height:1.25;&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;«interface»&lt;/span&gt;&lt;br&gt;&lt;b&gt;Command&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ label: string&lt;br&gt;+ coalesceKey?: string&lt;br&gt;+ mergeWithPrevious?: boolean&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ apply(draft: DiagramDoc): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=WenQuanYi Zen Hei;fillColor=#E9F1FD;strokeColor=#45453F;" vertex="1" parent="1"><mxGeometry x="430" y="40" width="270" height="138" as="geometry"/></mxCell><mxCell id="store" value="&lt;p style=&quot;margin:0;margin-top:5px;text-align:center;line-height:1.25;&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;«store»&lt;/span&gt;&lt;br&gt;&lt;b&gt;DocumentStore&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ doc: DiagramDoc&lt;br&gt;+ history: HistoryState&lt;br&gt;+ canUndo: boolean&lt;br&gt;+ canRedo: boolean&lt;br&gt;+ undoLabel: string | null&lt;br&gt;+ redoLabel: string | null&lt;br&gt;+ lastChange: execute | undo | redo | set | remote&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ execute(cmd: Command): void&lt;br&gt;+ undo(): void&lt;br&gt;+ redo(): void&lt;br&gt;+ setDoc(doc, opts): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=12;fontFamily=WenQuanYi Zen Hei;fillColor=#FFFDF4;strokeColor=#45453F;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="330" height="257" as="geometry"/></mxCell><mxCell id="hist" value="&lt;p style=&quot;margin:0;margin-top:5px;text-align:center;line-height:1.25;&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;«utility»&lt;/span&gt;&lt;br&gt;&lt;b&gt;CommandHistory（history.ts）&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:17px;&quot;&gt;+ HISTORY_LIMIT = 200&lt;br&gt;+ COALESCE_WINDOW_MS = 600&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0;margin-left:7px;margin-top:3px;line-height:1