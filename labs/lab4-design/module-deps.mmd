flowchart TB
  APP([入口与页面 main / App / pages])
  SH[features/shell 外壳]
  CV[features/canvas 画布]
  PL[plugins 图类型插件]
  ST[store 状态层]
  IOX[io 图片导出]
  CT[core 插件契约与事件]
  CMD[core/commands 命令与历史]
  LAY[core/layout 自动布局]
  CIO[core/io 序列化与持久化]
  COL[core/collab 协作适配]
  MOD[(core/model 数据模型)]
  APP --> CV
  APP --> SH
  CIO --> LAY
  CMD --> MOD
  COL --> MOD
  CT --> CMD
  CV --> IOX
  CV --> PL
  CV --> ST
  IOX --> CIO
  LAY --> CT
  PL --> LAY
  SH --> IOX
  SH --> PL
  SH --> ST
  ST --> COL
  ST --> CT
